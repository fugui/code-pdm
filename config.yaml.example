server:
  port: ":8085"
  gin_log: true

auth:
  standalone_mode: false             # 是否以独立系统模式运行（false: 微前端模式，依赖主门户；true: 独立部署运行）
  jwt_secret: "ABCDEFGHIJKLMNOPQRSTVUWXYZ0987654321"
  password_login_enabled: true       # 独立模式下是否启用本地账号密码登录
  oauth2:                            # 独立模式下的企业 OAuth2/OIDC 单点登录配置
    enabled: false                   # 是否启用独立 SSO
    client_id: ""                    # Client ID
    client_secret: ""                # Client Secret
    auth_url: ""                     # Authorization Endpoint
    token_url: ""                    # Token Endpoint
    userinfo_url: ""                 # UserInfo Endpoint
    redirect_url: ""                 # 回调地址，如 http://192.168.56.18:8085/api/oauth2/callback
    scopes: ["openid", "profile", "email"]
    admin_list:
      - "admin@code-shield.com"
    allowed_email_domains:
      - "@yourcompany.com"
    field_mapping:
      username: "preferred_username"
      email: "email"
      name: "name"


database:
  driver: "postgres"
  host: "127.0.0.1"
  port: 5432
  user: "postgres"
  password: "YOUR_POSTGRES_PASSWORD"
  dbname: "code_shield"
  sslmode: "disable"
  timezone: "Asia/Shanghai"
  max_open_conns: 50
  max_idle_conns: 10
